<ResourceDictionary
    x:Class="NinaHaTelemetry.Options"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DataTemplate x:Key="Toldelmer - HA Telemetry_Options">
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="30" />
                <RowDefinition Height="40" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="Enabled" />
            <CheckBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding Enabled}" />

            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Broker host" />
            <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Host}" />

            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Port" />
            <TextBox Grid.Row="2" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding Port}" />

            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="TLS" />
            <CheckBox Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="{Binding UseTls}" />

            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Username" />
            <TextBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Text="{Binding Username}" />

            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="Password" />
            <PasswordBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center"
                         Loaded="PasswordBox_Loaded" PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Discovery prefix" />
            <TextBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" Text="{Binding DiscoveryPrefix}" />

            <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="Node id" />
            <TextBox Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" Text="{Binding NodeId}" />

            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Preview width (px, 0 = off)" />
            <TextBox Grid.Row="8" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding PreviewMaxWidth}" />

            <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="PHD2 guide frame every (s, 0 = off)" />
            <TextBox Grid.Row="9" Grid.Column="1" Width="80" HorizontalAlignment="Left" VerticalAlignment="Center" Text="{Binding GuideImageInterval}" />

            <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Width="180" Height="28" Margin="0,0,10,0" Command="{Binding ApplyCommand}">
                    <TextBlock Text="Apply and reconnect" />
                </Button>
                <Button Width="180" Height="28" Command="{Binding RemoveEntitiesCommand}">
                    <TextBlock Text="Remove HA entities" />
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="11" VerticalAlignment="Center" Text="Status" />
            <TextBlock Grid.Row="11" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Status}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
