<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>NINA.HaTelemetry</AssemblyName>
    <RootNamespace>NinaHaTelemetry</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NINA.Plugin" Version="3.2.0.9001">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
  </ItemGroup>

  <Target Name="StagePlugin" AfterTargets="Build">
    <PropertyGroup>
      <StageDir>$(MSBuildProjectDirectory)/../dist/HA Telemetry/</StageDir>
    </PropertyGroup>
    <ItemGroup>
      <StageFiles Include="$(OutDir)NINA.HaTelemetry.dll;$(OutDir)NINA.HaTelemetry.pdb;$(OutDir)MQTTnet.dll" />
    </ItemGroup>
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="@(StageFiles)" DestinationFolder="$(StageDir)" />
  </Target>
</Project>
